  "relations": [
    {"from": "lost_centers", "to": "center_memberships", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "한 센터는 여러 담당자 소속을 가질 수 있고, 각 소속은 정확히 하나의 센터에 속한다.", "assumptions": []},
