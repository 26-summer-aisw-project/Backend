    {"from": "users", "to": "found_items", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "한 회원은 여러 습득물을 등록할 수 있고, 각 습득물은 정확히 한 습득자가 등록한다.", "assumptions": []},
    {"from": "lost_centers", "to": "found_items", "min_from": 0, "max_from": "*", "min_to": 0, "max_to": 1, "description": "파트너 센터는 여러 물건을 보관할 수 있으며, 센터 인계 전 습득물은 보관 센터가 없을 수 있다.", "assumptions": ["dashboard_enabled=true인 PARTNER 센터만 보관 센터로 허용한다."]},
    {"from": "users", "to": "lost_reports", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "한 회원은 여러 분실 신고를 만들 수 있고, 각 신고는 정확히 한 신고자에 속한다.", "assumptions": []},
    {"from": "found_items", "to": "found_item_images", "min_from": 1, "max_from": "*", "min_to": 1, "max_to": 1, "description": "각 습득물은 최소 한 장의 사진을 가지며, 각 사진은 정확히 한 습득물에 속한다.", "assumptions": []},
    {"from": "found_items", "to": "item_features", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "센터 입고 후 특징을 0개 이상 기록할 수 있고, 각 특징은 정확히 한 습득물에 속한다.", "assumptions": []},
    {"from": "found_items", "to": "handover_records", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "습득물은 인계 이력이 없거나 여러 인계 이력을 가질 수 있고, 각 인계 이력은 정확히 한 습득물에 속한다.", "assumptions": ["P0에서는 하나의 확정 인계만 허용하지만 이력은 보존한다."]},
    {"from": "lost_reports", "to": "report_waypoints", "min_from": 1, "max_from": "*", "min_to": 1, "max_to": 1, "description": "각 신고는 단일 장소 또는 복수 장소 핀을 반드시 하나 이상 가지며, 각 핀은 정확히 한 신고에 속한다.", "assumptions": []},
    {"from": "found_items", "to": "match_candidates", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "한 습득물은 여러 신고의 후보가 될 수 있고, 각 후보는 정확히 한 습득물을 가리킨다.", "assumptions": []},
    {"from": "lost_reports", "to": "match_candidates", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "한 신고는 후보가 없거나 최대 5개의 활성 후보를 가지며, 각 후보는 정확히 한 신고에 속한다.", "assumptions": ["최대 5개는 서비스 계층에서 강제한다."]},
    {"from": "lost_reports", "to": "candidate_accesses", "min_from": 0, "max_from": "*", "min_to": 1, "max_to": 1, "description": "한 신고는 열람 권한이 없거나 여러 버전의 열람 이력을 가질 수 있고, 각 권한은 정확히 한 신고에 속한다.", "assumptions": []},
    {"from": "return_records", "to": "point_ledger", "min_from": 0, "max_from": 1, "min_to": 0, "max_to": 1, "description": "반환 보상은 최대 한 개의 포인트 원장 거래를 만들고, 다른 유형의 원장 거래는 반환과 무관할 수 있다.", "assumptions": ["원장 reference_type/reference_id로 관계를 검증한다."]},
    {"from": "candidate_accesses", "to": "point_ledger", "min_from": 1, "max_from": 1, "min_to": 0, "max_to": 1, "description": "각 유료 후보 열람 권한은 정확히 한 차감 거래를 참조하고, 해당 거래는 하나의 열람 권한에만 사용된다.", "assumptions": []}
  ]
